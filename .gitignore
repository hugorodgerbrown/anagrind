# Build artifacts — regenerated by build.sh, never committed
.vocab-cache.pkl
payload.b64
payload.gz
anagrind.html

# dist/ IS committed. Render publishes it directly with no build step, so the
# deploy cannot break on a build image that lacks Python or on a slow install.
# Rebuild with `python3 build_dist.py` and commit.

__pycache__/
*.pyc
.pytest_cache/
.DS_Store
